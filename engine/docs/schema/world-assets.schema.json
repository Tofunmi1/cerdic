{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://victoriavr.com/spatial-lab/schema/world-assets-1.json",
  "title": "Spatial Lab world asset catalog",
  "description": "External and captured world inputs with stable IDs, coordinate metadata, and source/license provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "uri", "revision", "source", "spatial", "usage"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{2,127}$" },
        "kind": { "enum": ["ogc_3d_tiles", "arcgis_i3s", "gltf", "vector_features", "height_grid", "point_cloud"] },
        "uri": { "type": "string", "minLength": 1 },
        "revision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceVersion"],
          "properties": {
            "sourceVersion": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "publisher", "url", "license", "attribution"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "publisher": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "uri" },
            "license": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "url"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "format": "uri" },
                "termsReviewedAt": { "type": "string", "format": "date" },
                "notes": { "type": "string" }
              }
            },
            "attribution": { "type": "string", "minLength": 1 },
            "capturePeriod": { "type": "string", "minLength": 4 }
          }
        },
        "spatial": {
          "type": "object",
          "additionalProperties": false,
          "required": ["crs", "verticalDatum", "units", "localOrigin"],
          "properties": {
            "crs": { "type": "string", "minLength": 1 },
            "verticalDatum": { "type": "string", "minLength": 1 },
            "units": { "const": "metres" },
            "localOrigin": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": { "type": "number" }
            },
            "localTransform": {
              "type": "array",
              "minItems": 16,
              "maxItems": 16,
              "items": { "type": "number" }
            }
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["display", "modify", "redistribute", "aiProcessing", "attributionRequired"],
          "properties": {
            "display": { "type": "boolean" },
            "modify": { "type": "boolean" },
            "redistribute": { "type": "boolean" },
            "aiProcessing": { "enum": ["allowed", "prohibited", "review_required"] },
            "attributionRequired": { "type": "boolean" },
            "cachePolicy": { "enum": ["project_bundle", "http_cache_only", "no_cache"] }
          }
        },
        "semanticLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["featureId", "relation"],
            "properties": {
              "featureId": { "type": "string", "minLength": 1 },
              "relation": { "enum": ["depicts", "overlays", "collides_with", "navigates"] }
            }
          }
        }
      }
    }
  }
}

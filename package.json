{
  "name": "spatial-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run engine:build:dev && bun scripts/dev.ts",
    "engine:build": "bun scripts/build-engine.ts",
    "engine:build:dev": "bun scripts/build-engine.ts --dev",
    "schema:check": "bun scripts/schema.ts",
    "schema:generate": "bun scripts/schema.ts --write",
    "wasm:build": "bun scripts/build-wasm.ts",
    "css": "bun scripts/gen-css.ts",
    "css:check": "bun scripts/gen-css.ts --check",
    "build": "bun run engine:build && bun run typecheck && bun run css && vite build",
    "build:web": "bun run css && vite build",
    "start": "bun server/index.ts",
    "typecheck": "bun run schema:check && tsc -b --pretty",
    "test": "bun run wasm:build && bun test tests/*.test.ts && cargo test --manifest-path rust/geometry/Cargo.toml",
    "test:e2e": "bun run wasm:build && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@react-three/drei": "^10",
    "@react-three/fiber": "^9",
    "@react-three/xr": "^6",
    "@xyflow/react": "^12.12.1",
    "elkjs": "^0.12.1",
    "lucide-react": "^1.53.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185",
    "zod": "^4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185",
    "@vitejs/plugin-react": "^5.0.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "typescript": "~5.9.3",
    "vite": "^7.0.0"
  }
}

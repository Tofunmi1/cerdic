# With no provider configured, the app uses a labelled deterministic mock.
LLM_PROVIDER=mock
# To use a compatible chat-completions endpoint:
# LLM_PROVIDER=chat-completions
# LLM_API_URL=https://your-provider.example/v1/chat/completions
# LLM_API_KEY=your-server-only-key
# LLM_MODEL=your-model
PORT=3001
